@model CourierManagement.Web.Models.ParcelCreateVm

@{
    ViewData["Title"] = "Book Parcel";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Book a Parcel</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="ParcelTypeId" class="form-label">Parcel Type</label>
                    <select asp-for="ParcelTypeId" asp-items="Model.ParcelTypes" class="form-select"></select>
                    <span asp-validation-for="ParcelTypeId" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="WeightKg" class="form-label"></label>
                    <input asp-for="WeightKg" class="form-control" />
                    <span asp-validation-for="WeightKg" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="DeliverySpeed" class="form-label"></label>
                    <select asp-for="DeliverySpeed" class="form-select" asp-items="Html.GetEnumSelectList<CourierManagement.Domain.Enums.DeliverySpeed>()"></select>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="DeliveryPriority" class="form-label"></label>
                    <select asp-for="DeliveryPriority" class="form-select" asp-items="Html.GetEnumSelectList<CourierManagement.Domain.Enums.DeliveryPriority>()"></select>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="PaymentMethod" class="form-label"></label>
                    <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<CourierManagement.Domain.Enums.PaymentMethod>()"></select>
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="CodAmount" class="form-label">COD Amount</label>
                    <input asp-for="CodAmount" class="form-control" />
                    <span asp-validation-for="CodAmount" class="text-danger"></span>
                    <div class="form-text">Required only if payment method is CashOnDelivery.</div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <h2 class="h6 mb-3">Sender</h2>
                    <div class="mb-3">
                        <label asp-for="SenderName" class="form-label"></label>
                        <input asp-for="SenderName" class="form-control" />
                        <span asp-validation-for="SenderName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SenderPhone" class="form-label"></label>
                        <input asp-for="SenderPhone" class="form-control" />
                        <span asp-validation-for="SenderPhone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="SenderAddress" class="form-label"></label>
                        <textarea asp-for="SenderAddress" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="SenderAddress" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <h2 class="h6 mb-3">Receiver</h2>
                    <div class="mb-3">
                        <label asp-for="ReceiverName" class="form-label"></label>
                        <input asp-for="ReceiverName" class="form-control" />
                        <span asp-validation-for="ReceiverName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReceiverPhone" class="form-label"></label>
                        <input asp-for="ReceiverPhone" class="form-control" />
                        <span asp-validation-for="ReceiverPhone" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReceiverAddress" class="form-label"></label>
                        <textarea asp-for="ReceiverAddress" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ReceiverAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" type="submit">Create Order</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

