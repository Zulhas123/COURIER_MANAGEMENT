@model CourierManagement.Domain.Entities.Parcel

@{
    ViewData["Title"] = "Parcel Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Parcel Details</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Invoice" asp-route-id="@Model.Id">Invoice</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small mb-1">Tracking ID</div>
                <div class="h5 mb-3">@Model.TrackingId</div>

                <dl class="row mb-0">
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">@Model.Status</dd>
                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">@Model.ParcelType?.Name</dd>
                    <dt class="col-sm-5">Weight</dt>
                    <dd class="col-sm-7">@Model.WeightKg.ToString("0.###") kg</dd>
                    <dt class="col-sm-5">Delivery Charge</dt>
                    <dd class="col-sm-7">@Model.DeliveryCharge.ToString("0.00")</dd>
                    <dt class="col-sm-5">Total Payable</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.TotalPayable.ToString("0.00")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <h2 class="h6">Sender</h2>
                        <div class="fw-semibold">@Model.SenderName</div>
                        <div class="text-muted">@Model.SenderPhone</div>
                        <div class="text-muted">@(!string.IsNullOrWhiteSpace(Model.SenderAddress) ? Model.SenderAddress : "-")</div>
                    </div>
                    <div class="col-12 col-md-6">
                        <h2 class="h6">Receiver</h2>
                        <div class="fw-semibold">@Model.ReceiverName</div>
                        <div class="text-muted">@Model.ReceiverPhone</div>
                        <div class="text-muted">@Model.ReceiverAddress</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

