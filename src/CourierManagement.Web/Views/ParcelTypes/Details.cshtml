@model CourierManagement.Domain.Entities.ParcelType

@{
    ViewData["Title"] = "Parcel Type Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Parcel Type Details</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "-")</dd>

            <dt class="col-sm-3">Base Rate</dt>
            <dd class="col-sm-9">@Model.BaseRate.ToString("0.00")</dd>

            <dt class="col-sm-3">Per Kg Rate</dt>
            <dd class="col-sm-9">@Model.PerKgRate.ToString("0.00")</dd>

            <dt class="col-sm-3">Active</dt>
            <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>
    </div>
</div>

