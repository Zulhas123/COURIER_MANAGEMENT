@model CourierManagement.Web.Models.ParcelTypeFormVm

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="BaseRate" class="form-label"></label>
        <input asp-for="BaseRate" class="form-control" />
        <span asp-validation-for="BaseRate" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="PerKgRate" class="form-label"></label>
        <input asp-for="PerKgRate" class="form-control" />
        <span asp-validation-for="PerKgRate" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive"></label>
        </div>
    </div>
</div>

